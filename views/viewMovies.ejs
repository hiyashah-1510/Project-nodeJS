<%- include('header') %>

  <link rel="stylesheet" href="/assets/css/index.css">

  <section class="movies-container">
    <h1>All Movies</h1>

    <table class="movie-table">
      <thead>
        <tr>
          <th>Poster</th>
          <th>Name</th>
          <th>Category</th>
          <th>Rating</th>
          <th>Year</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% movies.forEach(movie=> { %>
          <tr>
            <td>
              <img src="<%= movie.image %>" width="80">
            </td>

            <td>
              <%= movie.name %>
            </td>
            <td>
              <%= movie.category %>
            </td>
            <td>
              <%= movie.rating %>
            </td>
            <td>
              <%= movie.year %>
            </td>
            <td>
              <a href="/movies/<%= movie._id %>" class="btn-view">View</a>

              <a href="/edit/<%= movie._id %>" class="btn-edit">Edit</a>

              <a href="/delete/<%= movie._id %>" class="btn-delete">Delete</a>
            </td>
          </tr>
          <% }) %>
      </tbody>

    </table>
  </section>

  <%- include('footer') %>