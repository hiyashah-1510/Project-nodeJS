<link rel="stylesheet" href="/css/style.css">

<header>
    <h1>Book Store</h1>
    <a href="/add">+ Add Book</a>
</header>

<div class="container">
    <div class="book-grid">
        <% books.forEach(book => { %>

            <div class="book-card">
                <img src="/uploads/<%= book.image %>">

                <div class="book-info">
                    <h3><%= book.title %></h3>
                    <p><%= book.author %></p>
                    <p><%= book.category %></p>
                    <p>₹<%= book.price %></p>
                    <p>Qty: <%= book.quantity %></p>

                    <div class="actions">
                        <a href="/edit/<%= book._id %>" class="edit">Edit</a>
                        <a href="/delete/<%= book._id %>" class="delete">Delete</a>
                    </div>
                </div>
            </div>

        <% }) %>
    </div>
</div>