<%- include('header') %>

<section class="form-section">
  <div class="add-movie-container">
    <h2>Add New Movie </h2>

    <form action="/movies/add" method="post" enctype="multipart/form-data" class="movie-form">

      <div class="form-grid">

        <div class="form-group">
          <label>Movie Title</label>
          <input type="text" name="name" placeholder="Enter movie title" required>
        </div>

        <div class="form-group">
          <label>Actors</label>
          <input type="text" name="actors" placeholder="Shah Rukh Khan, Deepika Padukone">
        </div>

        <div class="form-group">
          <label>Directors</label>
          <input type="text" name="directors" placeholder="Director name">
        </div>

        <div class="form-group">
          <label>Languages</label>
          <input type="text" name="languages" placeholder="Hindi, English">
        </div>

        <div class="form-group full-width">
          <label>Description</label>
          <textarea name="desc" rows="3" placeholder="Write description..." required></textarea>
        </div>

        <div class="form-group">
          <label>Category</label>
          <input type="text" name="category" placeholder="Action, Drama" required>
        </div>

        <div class="form-group">
          <label>Rating</label>
          <input type="number" step="0.1" name="rating" placeholder="8.5" required>
        </div>

        <div class="form-group">
          <label>Year</label>
          <input type="text" name="year" placeholder="2024" required>
        </div>

        <div class="form-group full-width">
          <label>Upload Poster</label>
          <input type="file" name="image" required>
        </div>

      </div>

      <button type="submit" class="btn-submit">+ Add Movie</button>

    </form>
  </div>
</section>

<%- include('footer') %>