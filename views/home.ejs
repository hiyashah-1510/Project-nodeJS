<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>

    <style>
        body {
            font-family: Arial;
            margin: 40px;
            background: #f4f4f4;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        .cards {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            flex: 1;
            background: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        }

        .card h3 {
            margin-bottom: 10px;
        }

        .card p {
            font-size: 24px;
            font-weight: bold;
        }

        .add {
            background: green;
            color: white;
            padding: 10px 15px;
            border-radius: 5px;
            text-decoration: none;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            margin-top: 20px;
        }

        th,
        td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: center;
        }

        th {
            background: #333;
            color: white;
        }

        .edit {
            background: orange;
            color: white;
            padding: 5px 10px;
            border-radius: 4px;
            text-decoration: none;
        }

        .delete {
            background: red;
            color: white;
            padding: 5px 10px;
            border-radius: 4px;
            text-decoration: none;
        }
    </style>

</head>

<body>

    <h1>Todo Dashboard</h1>

    <div class="cards">

        <div class="card">
            <h3>Total Tasks</h3>
            <p>
                <%= totalTasks %>
            </p>
        </div>

        <div class="card">
            <h3>Pending Tasks</h3>
            <p>
                <%= pendingTasks %>
            </p>
        </div>

        <div class="card">
            <h3>Completed Tasks</h3>
            <p>
                <%= completedTasks %>
            </p>
        </div>

        <div class="card">
            <h3>In Progress</h3>
            <p>
                <%= progressTasks %>
            </p>
        </div>

    </div>

    <a class="add" href="/add">Add New Task</a>

    <table>

        <tr>
            <th>ID</th>
            <th>Task</th>
            <th>Description</th>
            <th>Status</th>
            <th>Category</th>
            <th>Action</th>
        </tr>

        <% tasks.forEach(task=> { %>

            <tr>
                <td>
                    <%= task.id %>
                </td>
                <td>
                    <%= task.task %>
                </td>
                <td>
                    <%= task.description %>
                </td>
                <td>
                    <%= task.status %>
                </td>
                <td>
                    <%= task.category %>
                </td>

                <td>
                    <a class="edit" href="/edit/<%= task.id %>">Edit</a>
                    <a class="delete" href="/delete/<%= task.id %>">Delete</a>
                </td>

            </tr>

            <% }) %>

    </table>

</body>

</html>